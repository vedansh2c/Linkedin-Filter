{
  "manifest_version": 3,
  "name": "LinkedIn Word Filter",
  "version": "1.0.2",
  "description": "Collapse LinkedIn feed posts that lack your chosen words or phrases.",
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-word-filter@vedansh2c.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "LinkedIn Word Filter",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["filter-core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
